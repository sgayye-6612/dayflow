# Copy this file to ".env" and fill in your values. Never share or commit .env.

# PostgreSQL connection. Leave empty to use a local SQLite file (server/dayflow.db) instead.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/dayflow

# Any long random string (32+ characters). Used to sign login tokens.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters

# Voice calls with Flo: your FREE Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: an extra code needed before a voice call (recommended online)
DAYFLOW_ACCESS_CODE=

# Optional settings (the defaults are fine)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Aoede
DAYFLOW_CALLS_PER_10_MIN=10
