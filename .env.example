# 1. Paste your FREE Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Optional: protect calls with a code, so only you can start them (strongly recommended online)
DAYFLOW_ACCESS_CODE=

# Optional settings (the defaults are fine)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Aoede
DAYFLOW_CALLS_PER_10_MIN=10
